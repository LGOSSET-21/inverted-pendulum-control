<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Massive rods · Swing-up laboratory</title><style>
:root{color-scheme:light;--ink:#183644;--muted:#65808c;--teal:#168e87}*{box-sizing:border-box}body{margin:0;background:#edf2f3;color:var(--ink);font:16px/1.6 system-ui,-apple-system,sans-serif}main{max-width:1180px;margin:0 auto;padding:32px 24px 50px}a{color:var(--teal)}header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin:22px 0}h1{font-size:clamp(30px,4vw,47px);line-height:1.1;letter-spacing:-1.5px;margin:9px 0}p{margin:8px 0}.eyebrow{text-transform:uppercase;font-size:11px;letter-spacing:2px;font-weight:750;color:var(--teal)}.muted{color:var(--muted)}.pill{display:inline-flex;padding:6px 12px;border-radius:30px;background:#e1f2ec;color:#23745d;font-size:12px;font-weight:650;white-space:nowrap}.lab{background:white;border:1px solid #dbe6e8;border-radius:24px;overflow:hidden;box-shadow:0 20px 65px #2647500b}.labhead{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;border-bottom:1px solid #edf1f2}.legend{display:flex;gap:14px;color:var(--muted);font-size:12px}.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:5px}.canvaswrap{position:relative;background:linear-gradient(180deg,#fafdfd,#eff5f6)}canvas{display:block;width:100%;height:610px}.axisnote{position:absolute;top:18px;left:24px;font-size:11px;letter-spacing:1px;color:#7e959f;pointer-events:none}.controls{padding:20px 24px;border-top:1px solid #e4ecee}.row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.row .time{margin-left:auto;font-variant-numeric:tabular-nums;font-size:23px;font-weight:600}button,select{font:inherit;border-radius:10px;border:1px solid #ccdbde;background:white;color:var(--ink);padding:10px 16px}button{cursor:pointer}#play{background:var(--ink);border-color:var(--ink);color:white;min-width:110px}input[type=range]{width:100%;accent-color:var(--teal);margin:19px 0 0}label{font-size:13px;color:var(--muted)}.timeline{display:flex;justify-content:space-between;font-size:11px;color:var(--muted)}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:22px 0}.stat{padding:18px;background:white;border-radius:15px;border:1px solid #e0e9eb}.stat span{display:block;color:var(--muted);font-size:12px}.stat strong{font-size:26px;font-weight:600;font-variant-numeric:tabular-nums}.details{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:30px}h2{font-size:20px;letter-spacing:-.4px}details{background:white;border:1px solid #dfe8eb;border-radius:14px;padding:18px;margin-top:20px}summary{cursor:pointer;font-weight:600}.forcebar{height:5px;background:#e5edef;border-radius:5px;margin-top:9px;overflow:hidden}.forcebar div{height:100%;width:0;background:#da9568}.footer{font-size:12px;color:var(--muted);margin-top:24px}button:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #51b6b1;outline-offset:3px}@media(max-width:700px){main{padding:16px 12px}header{display:block}.legend{gap:8px}canvas{height:510px}.labhead,.controls{padding:14px}.stats{grid-template-columns:1fr 1fr}.details{grid-template-columns:1fr}.row .time{font-size:18px}.labhead{flex-wrap:wrap;gap:10px}}</style></head><body><main>
<a href="massive-rods.html">← Near-upright comparison</a><header><div><div class="eyebrow">Control laboratory / experiment 02</div><h1>From hanging to balanced.</h1><p class="muted">Three massive rods. One motor. A planned physical manoeuvre.</p></div><span class="pill">10 g added to each rod</span></header>
<div class="lab"><div class="labhead"><div><span class="eyebrow">Current phase</span><br><strong id="phase">Ready · hanging equilibrium</strong></div><div class="legend"><span><i class="dot" style="background:#168e87"></i>Link 1</span><span><i class="dot" style="background:#8167b4"></i>Link 2</span><span><i class="dot" style="background:#d9973e"></i>Link 3</span></div></div><div class="canvaswrap"><div class="axisnote">FRONT VIEW · FIXED METRE SCALE · TRAILS: LAST 0.8 s</div><canvas id="scene" aria-label="Animated massive triple pendulum on a motorised cart"></canvas></div><div class="controls"><div class="row"><button id="play">Play</button><button id="restart">Restart</button><label>Speed <select id="speed"><option value=".25">¼×</option><option value=".5">½×</option><option value="1" selected>1×</option><option value="2">2×</option></select></label><label><input id="trails" type="checkbox" checked> Trails</label><span class="time" id="time">0.00 s</span></div><input id="scrub" type="range" min="0" max="12" step=".005" value="0" aria-label="Simulation time"><div class="timeline"><span>0 s · hanging</span><span>6 s · upright LQR handoff</span><span>12 s</span></div></div></div>
<div class="stats"><div class="stat"><span>Motor force</span><strong id="force">0.00 N</strong><div class="forcebar"><div id="forcefill"></div></div></div><div class="stat"><span>Cart position</span><strong id="position">0.000 m</strong></div><div class="stat"><span>Suspended mass</span><strong>230 g</strong></div><div class="stat"><span>Actuator envelope</span><strong>±8 N</strong></div></div>
<div class="details"><div><h2>What you are watching</h2><p>The cart moves to raise all three links from their downward equilibrium. A newly optimised six-second reference is tracked by time-varying feedback, then an upright LQR maintains balance.</p><p>The rods have uniformly distributed mass and rotational inertia. The endpoint masses are retained. Only the cart is actuated.</p></div><div><h2>Verified physical replay</h2><p id="result"></p><p>The trajectory is integrated from the nonlinear equations with force saturation. A second run halves the integration step. This is one tested nominal manoeuvre, not guaranteed recovery from arbitrary states.</p></div></div>
<details><summary>Model, calculations and display</summary><p>Cart: 0.8 kg. Three rods: 0.010 kg and 1/6 m each. Three endpoint masses: 0.2/3 kg each. Rod inertia about its centre: I = mL²/12. Cart viscous friction: 0.08 N·s/m. Free, frictionless hinges; rigid rods; ideal full-state measurements. Link collisions and contact with the cart or rail are not modelled.</p><p>The planner uses Hermite–Simpson collocation. The old trajectory is only an initial guess; the reference is recomputed with the massive-rod equations. Feasibility is assessed by independent forward integration, not by the appearance of the animation. No global or time-optimal solution is claimed.</p><p>Playback interpolates generalised coordinates using their velocities, then reconstructs fixed-length rods. Trails, colours and force-arrow scale are visual aids. The animation does not apply extra forces or correct positions. This stage has no mouse dragging.</p><p><a href="../results/massive_rods/swingup_validation.json">Verification metrics</a> · <a href="../results/massive_rods/swingup_lqr.csv">Full trajectory CSV</a> · <a href="../docs/massive-rods.md">Model derivation</a></p></details><p class="footer">Educational simulation · AI-assisted development · No hardware validation. The original massless-rod demo remains separate.</p>
</main><script>
const sim=__SIMULATION__,rows=sim.rows,el=id=>document.getElementById(id),canvas=el('scene'),ctx=canvas.getContext('2d'),colors=['#168e87','#8167b4','#d9973e'];let t=0,playing=false,last=null;
function sample(time){if(time<=0)return rows[0].slice();if(time>=rows.at(-1)[0])return rows.at(-1).slice();let lo=0,hi=rows.length-1;while(hi-lo>1){const k=(lo+hi)>>1;if(rows[k][0]<=time)lo=k;else hi=k}const a=rows[lo],b=rows[hi],h=b[0]-a[0],f=(time-a[0])/h,s=a.map((v,j)=>v+(b[j]-v)*f);for(const j of [1,3,5,7])s[j]=(2*f**3-3*f*f+1)*a[j]+(f**3-2*f*f+f)*h*a[j+1]+(-2*f**3+3*f*f)*b[j]+(f**3-f*f)*h*b[j+1];return s}
function points(s,w,h,scale){let x=w/2+s[1]*scale,y=h/2;const p=[[x,y]];for(let j=0;j<3;j++){x+=scale/6*Math.sin(s[3+2*j]);y-=scale/6*Math.cos(s[3+2*j]);p.push([x,y])}return p}
function line(a,b,color,width){ctx.strokeStyle=color;ctx.lineWidth=width;ctx.beginPath();ctx.moveTo(...a);ctx.lineTo(...b);ctx.stroke()}
function circle(x,y,r,fill,stroke){ctx.beginPath();ctx.arc(x,y,r,0,2*Math.PI);ctx.fillStyle=fill;ctx.fill();if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=2;ctx.stroke()}}
function draw(){const w=canvas.clientWidth,h=canvas.clientHeight,dpr=Math.min(devicePixelRatio||1,2);if(canvas.width!==Math.round(w*dpr)||canvas.height!==Math.round(h*dpr)){canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr)}ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,w,h);ctx.lineCap='round';const scale=Math.min(420,(w-72)/2),s=sample(t),p=points(s,w,h,scale),cy=h/2;
ctx.setLineDash([3,7]);for(let x=-1;x<=1.01;x+=.25){const px=w/2+x*scale;line([px,50],[px,h-28],x===0?'#bfced4':'#e2eaed',1)}ctx.setLineDash([]);line([18,cy+31],[w-18,cy+31],'#b8cbd2',5);line([18,cy+37],[w-18,cy+37],'#dce6e9',2);
ctx.font='11px system-ui';ctx.fillStyle='#8197a1';for(let x=-1;x<=1.01;x+=.5)ctx.fillText(x.toFixed(1)+' m',w/2+x*scale-15,cy+58);
if(el('trails').checked&&t>0){for(let j=1;j<=3;j++){let previous=null;for(let k=0;k<=48;k++){const tt=Math.max(0,t-.8)+Math.min(t,.8)*k/48,q=points(sample(tt),w,h,scale)[j];if(previous){ctx.globalAlpha=.04+.4*k/48;line(previous,q,colors[j-1],2)}previous=q}ctx.globalAlpha=1}}
const x=p[0][0];ctx.shadowColor='#25465225';ctx.shadowBlur=14;ctx.shadowOffsetY=5;ctx.fillStyle='#264858';ctx.fillRect(x-29,cy-10,58,31);ctx.shadowBlur=0;ctx.shadowOffsetY=0;ctx.fillStyle='#4c6b79';ctx.fillRect(x-21,cy-5,42,7);circle(x-18,cy+24,8,'#193847');circle(x+18,cy+24,8,'#193847');circle(x-18,cy+24,3,'#a6bac3');circle(x+18,cy+24,3,'#a6bac3');
for(let j=0;j<3;j++){line(p[j],p[j+1],'#294956',11);line(p[j],p[j+1],colors[j],7)}circle(...p[0],8,'#edf5f7','#587584');for(let j=1;j<=3;j++){circle(...p[j],11,colors[j-1],'#35515d');circle(...p[j],3.5,'#eff7f7')}
if(Math.abs(s[9])>.08){const a=[x,cy-30],b=[x+s[9]/8*82,cy-30],sign=Math.sign(s[9]);line(a,b,'#cd7952',3);line(b,[b[0]-sign*8,b[1]-5],'#cd7952',2);line(b,[b[0]-sign*8,b[1]+5],'#cd7952',2)}
el('time').textContent=t.toFixed(2)+' s';el('scrub').value=t;el('force').textContent=s[9].toFixed(2)+' N';el('position').textContent=s[1].toFixed(3)+' m';el('forcefill').style.width=(Math.abs(s[9])/8*100)+'%';el('phase').textContent=t===0?'Ready · hanging equilibrium':t<6?'Swing-up · trajectory tracking':'Balance · upright LQR';}
function reset(){playing=false;t=0;last=null;el('play').textContent='Play';draw()}el('play').onclick=()=>{if(t>=12)t=0;playing=!playing;last=null;el('play').textContent=playing?'Pause':'Play';draw()};el('restart').onclick=reset;el('scrub').oninput=()=>{playing=false;el('play').textContent='Play';t=Number(el('scrub').value);draw()};el('trails').onchange=draw;window.addEventListener('resize',draw);document.addEventListener('visibilitychange',()=>{last=null});function frame(now){if(playing&&last!==null){t=Math.min(12,t+Math.max(0,Math.min(.05,(now-last)/1000))*Number(el('speed').value));draw();if(t>=12){playing=false;el('play').textContent='Replay'}}last=now;requestAnimationFrame(frame)}el('result').textContent=`Upright settling: ${sim.metrics.settling_s.toFixed(2)} s. Peak force: ${sim.metrics.peak_force_N.toFixed(2)} N. Maximum cart displacement: ${sim.metrics.max_cart_displacement_m.toFixed(3)} m.`;draw();requestAnimationFrame(frame);
</script></body></html>
